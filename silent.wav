# Sử dụng ffmpeg (nếu đã cài đặt)
ffmpeg -f lavfi -i anullsrc=r=48000:cl=mono -t 0.02 -c:a pcm_s16le silent.wav

# Hoặc sử dụng Python (không cần ffmpeg)
python3 -c "
import wave, struct
w = wave.open('silent.wav', 'w')
w.setnchannels(1)
w.setsampwidth(2)
w.setframerate(48000)
w.writeframes(b'\x00\x00' * 960)
w.close()
print('Đã tạo silent.wav')
"
